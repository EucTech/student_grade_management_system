<Window x:Class="StudentGradeManagementSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Student Grade Management System"
        Height="640" Width="1000"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown"
        Loaded="Window_Loaded">

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Student Grade Management System" FontSize="22" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Shortcuts: Enter = Add / Search   Ctrl+N = New   Ctrl+F = Search   Ctrl+U = Update   Del = Remove   F5 = Statistics   Esc = Clear"
                           Foreground="#DCE6F0" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#E9EDF2" Padding="12,6">
            <TextBlock x:Name="StatusText" Text="Ready." FontSize="13" />
        </Border>

        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Student Details" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                        <TextBlock Text="Name" />
                        <TextBox x:Name="NameInput" KeyDown="NameInput_KeyDown" />
                        <TextBlock Text="Grade (0 - 100)" />
                        <TextBox x:Name="GradeInput" KeyDown="GradeInput_KeyDown" />

                        <Button x:Name="AddButton" Content="Add Student" Click="AddButton_Click" />
                        <Button x:Name="UpdateButton" Content="Update Grade" Click="UpdateButton_Click" />
                        <Button x:Name="RemoveButton" Content="Remove Student" Click="RemoveButton_Click"
                                Background="{StaticResource DangerBrush}" />
                        <Button x:Name="ClearButton" Content="Clear Inputs" Click="ClearButton_Click"
                                Background="Gray" />

                        <TextBlock Text="Search" Style="{StaticResource SectionHeader}" />
                        <TextBox x:Name="SearchInput" KeyDown="SearchInput_KeyDown" />
                        <Button x:Name="SearchButton" Content="Search Student" Click="SearchButton_Click" />
                        <Button x:Name="ShowAllButton" Content="Display All Students" Click="ShowAllButton_Click" />

                        <TextBlock Text="Statistics" Style="{StaticResource SectionHeader}" />
                        <Button x:Name="AverageButton" Content="Calculate Average" Click="AverageButton_Click" />
                        <Button x:Name="HighLowButton" Content="Highest &amp; Lowest Grades" Click="HighLowButton_Click" />
                        <Button x:Name="StatisticsButton" Content="Full Class Report" Click="StatisticsButton_Click" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock x:Name="CountText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="Gray" />
                    <TextBlock Text="All Students" Style="{StaticResource SectionHeader}" Margin="0" />
                </DockPanel>

                <DataGrid Grid.Row="1"
                          x:Name="StudentsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          AlternatingRowBackground="#F7F9FB"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="StudentsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="2*" />
                        <DataGridTextColumn Header="Grade" Binding="{Binding Grade, Mode=OneWay}" Width="*" />
                        <DataGridTextColumn Header="Category" Binding="{Binding CategoryName, Mode=OneWay}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Average" Foreground="Gray" />
                            <TextBlock x:Name="AverageText" Text="-" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Highest" Foreground="Gray" />
                            <TextBlock x:Name="HighestText" Text="-" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Lowest" Foreground="Gray" />
                            <TextBlock x:Name="LowestText" Text="-" FontSize="20" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
